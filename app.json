{
  "expo": {
    "name": "Qiblanuma",
    "slug": "qiblanuma",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.masmatix.qiblanuma",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E6E6E"
      }
    },
    "ios": {
      "bundleIdentifier": "com.masmatix.qiblanuma",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used on this phone only, to calculate prayer times and the Qibla direction."
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used on this phone only, to calculate prayer times and the Qibla direction."
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-speech-recognition",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "5f2e99f2-7729-4a2c-a681-dcee916cd62a"
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F3EC"
    }
  }
}
